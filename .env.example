# Use variáveis de ambiente para credenciais do Google. NÃO comite client_secret.json.
# Exemplo de variáveis para desenvolvimento local e implantação.

# Flask
SECRET_KEY=your-secret-key-here
FLASK_ENV=development

# Google Calendar (necessário em produção)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# A URI de redirecionamento deve corresponder à configurada no Google Cloud Console
GOOGLE_REDIRECT_URI=http://localhost:5000/calendar/oauth2callback

# Banco de dados (ex.: PostgreSQL)
# Exemplo de formato: postgresql://usuario:senha@host:porta/nome_db.
DATABASE_URL=postgresql://postgres:password@db.host.supabase.co:5432/postgres

# Chave para criptografia de tokens (base64 urlsafe, 32 bytes).
# Exemplo para gerar em Python:
# >>> import base64, os; base64.urlsafe_b64encode(os.urandom(32)).decode()
TOKEN_ENCRYPTION_KEY=

# Redis para sessões no servidor (recomendado em produção)
REDIS_URL=redis://localhost:6379/0

# Origens CORS (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173

# Email (opcional)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Integração ERP (opcional)
ERP_BASE_URL=https://your-erp-api.com
ERP_TOKEN=your-erp-token

# Flags de cookie (defina 1 em produção com HTTPS)
SESSION_COOKIE_SECURE=1
SESSION_COOKIE_HTTPONLY=1
SESSION_COOKIE_SAMESITE=Lax

# Observações:
# - Nunca comite segredos reais (client secrets, tokens, chaves) no controle de versão.
# - Se um segredo foi comprometido, rotacione-o imediatamente.
SECRET_KEY=your-secret-key-here

