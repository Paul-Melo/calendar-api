# Example .env for local development and for reference.
# Do NOT commit real secrets. Copy this file to `.env` and fill values.

# Flask
SECRET_KEY=change-me-in-production
FLASK_ENV=development

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/calendar/oauth2callback

# Database (Supabase/Postgres)
# Example (do not commit real credentials):
# postgresql://user:password@host:5432/database
DATABASE_URL=postgresql://postgres:password@db.host.supabase.co:5432/postgres

# Token encryption key (base64 urlsafe, 16/24/32 bytes before base64)
TOKEN_ENCRYPTION_KEY=

# Redis (optional)
REDIS_URL=redis://localhost:6379/0

# CORS origins (comma separated)
CORS_ORIGINS=http://localhost:5173,https://cognitivatcc.com.br

# Cookie flags for production
SESSION_COOKIE_SECURE=1
SESSION_COOKIE_HTTPONLY=1
SESSION_COOKIE_SAMESITE=Lax
